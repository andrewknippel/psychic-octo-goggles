# Optional: https://newsapi.org free tier key. Without it, the pipeline still
# runs on Reddit + StockTwits + market data alone.
NEWSAPI_KEY=

# Reddit requires no key for read-only public JSON endpoints, but a real
# User-Agent string is required or requests get rate-limited/blocked.
REDDIT_USER_AGENT=stock-scanner/1.0 (by u/your_username)

# Buy alerts: the strict "buy the dip" list (down >= BUY_ALERT_DROP_PCT over
# the past week AND RSI <= BUY_ALERT_RSI_MAX). Both default to the rebound-scan
# thresholds; set them here to make the alert list stricter/looser on its own.
BUY_ALERT_DROP_PCT=8
BUY_ALERT_RSI_MAX=32

# Deep link the "Buy in Fidelity" button opens (symbol substituted for
# {ticker}). It lands on Fidelity's order ticket pre-filled to Buy -- you log
# in, review, and submit; the app never places a trade. Override only if
# Fidelity changes the path.
FIDELITY_TRADE_URL=https://digital.fidelity.com/ftgw/digital/trade-equity/index/orderEntry?ORDER_ACTION=B&SYMBOL={ticker}
