# Optional: https://newsapi.org free tier key. Without it, the pipeline still
# runs on Reddit + StockTwits + market data alone.
NEWSAPI_KEY=

# Reddit requires no key for read-only public JSON endpoints, but a real
# User-Agent string is required or requests get rate-limited/blocked.
REDDIT_USER_AGENT=stock-scanner/1.0 (by u/your_username)
